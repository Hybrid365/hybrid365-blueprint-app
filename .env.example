# Names only. No secrets.
# Local default should be staging once docs/HYBRID365_STAGING.md is in place.
# NEXT_PUBLIC_* is visible in the browser. Everything else is server-only.

# --- Public ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_STRIPE_HYROX_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_HYROX_UPFRONT_URL=
NEXT_PUBLIC_STRIPE_HYROX_16_WEEK_URL=
NEXT_PUBLIC_WHOP_JOIN_URL=
NEXT_PUBLIC_HYBRID75_VSL_URL=
NEXT_PUBLIC_HYBRID75_TELEGRAM_URL=
NEXT_PUBLIC_FREE_WEEK_TELEGRAM_URL=

# --- Server-only: data and auth ---
SUPABASE_SERVICE_ROLE_KEY=
HYROX_PORTAL_SIGNING_SECRET=
INTERNAL_ADMIN_EMAILS=
HYROX_COACH_EMAILS=
HYROX_APPLICATIONS_RAW_PAYLOAD=
HYROX_MIDDLEWARE_DEBUG=

# --- Server-only: feature flags (default unset / off) ---
HYROX_HOME_V2_ENABLED=
HYROX_HOME_V2_ATHLETE_IDS=
HYROX_HOME_V2_ATHLETE_EMAILS=
HYROX_HOME_V2_DEV_ALL=
HYROX_TODAY_V2_ENABLED=
HYROX_TODAY_V2_ATHLETE_IDS=
HYROX_TODAY_V2_ATHLETE_EMAILS=
HYROX_TODAY_V2_DEV_ALL=
HYROX_PERFORMANCE_HUB_ENABLED=
HYROX_PERFORMANCE_HUB_ATHLETE_IDS=
HYROX_PERFORMANCE_HUB_ATHLETE_EMAILS=
HYROX_PERFORMANCE_HUB_DEV_ALL=
HYROX_PERFORMANCE_PROFILE_ENABLED=
HYROX_PERFORMANCE_PROFILE_ATHLETE_IDS=
HYROX_PERFORMANCE_PROFILE_ATHLETE_EMAILS=
HYROX_PERFORMANCE_PROFILE_DEV_ALL=

# --- Server-only: staging guard ---
# staging | production
HYROX_ENV=
# Full production URL. Seed and migrate scripts must refuse this host.
HYROX_PRODUCTION_SUPABASE_URL=
# Set to 1 only on staging, and only when a write seed exists.
HYROX_STAGING_SEED=

# --- Server-only: other integrations ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
KIT_API_KEY=
KIT_TAG_ID=
KIT_HYROX_TAG_ID=
KIT_HYBRID75_TAG_ID=
WHOP_WEBHOOK_SECRET=
CHALLENGE_LOG_ADMIN_SECRET=
